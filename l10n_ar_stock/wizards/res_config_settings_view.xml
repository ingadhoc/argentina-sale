<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='warning_info']" position="after">
                <setting
                    id="arba_cot"
                    help="Permite generar el COT de ARBA una vez que se han asignado números de remitos en las entregas."
                    documentation="https://cot.arba.gov.ar/TransporteBienes/pages/remitos/PresentarRemitos.jsp">
                    <field name="group_arba_cot_enabled" />
                    <div class="row mt-2" invisible="not group_arba_cot_enabled">
                        <label for="arba_cot" class="col-md-6 o_light_label" string="Clave COT ARBA" />
                        <field name="arba_cot" class="oe_inline" password="True" />
                        <span class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company" />
                    </div>
                    <div class="text-muted mt-1" invisible="not group_arba_cot_enabled"> Indique la
                        clave COT utilizada para generación de remito electrónico / COT. Puede
                        probarla intentando subir cualquier archivo en este <a target="_blank"
                            href="https://cot.arba.gov.ar/TransporteBienes/pages/remitos/PresentarRemitos.jsp">
                        link</a> (el usuario es el CUIT). Si da error en nombre de archivo entonces
                        la clave es correcta. </div>
                </setting>
                <setting
                    id="cot_product_uom_qty_setting"
                    help="Designar tipo de cantidades en la generación del .txt del COT. En caso de estar tildado toma las cantidades entregadas y en caso de estar destildado toma las cantidades pedidas.">
                    <field name="cot_product_uom_qty" />
                    
                </setting>
            </xpath>
        </field>
    </record>

</odoo>