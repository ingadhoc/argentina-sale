<odoo>
    <!-- delivery slip copies are set on the operation type, so the report keeps them only for invoices -->
    <record id="act_report_xml_view" model="ir.ui.view">
        <field name="name">ir.actions.report.l10n_ar_stock_ux</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="l10n_ar_ux.act_report_xml_view"/>
        <field name="arch" type="xml">
            <field name="l10n_ar_copies" position="attributes">
                <attribute name="invisible">report_name not in ['account.report_invoice', 'account.report_invoice_with_payments']</attribute>
            </field>
        </field>
    </record>
</odoo>
