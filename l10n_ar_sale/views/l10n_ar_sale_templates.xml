<odoo>
    <template id="sale_order_portal_content" priority="20" inherit_id="sale.sale_order_portal_content" name="Sales Order">

        <xpath expr="//div[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-field">line.report_price_unit</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-field">line.report_price_subtotal</attribute>
        </xpath>

        <!-- the taxes column follows vat_discriminated, so rows keyed on display_taxes must too -->
        <t t-set="display_taxes" position="after">
            <t t-set="display_taxes" t-value="sale_order.vat_discriminated"/>
        </t>

        <xpath expr="//td[@name='td_product_taxes']/span" position="attributes">
            <attribute name="t-out">', '.join(line.tax_ids.mapped('tax_label'))</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_taxes']/span" position="attributes">
            <attribute name="t-out">', '.join(section_line['tax_labels'])</attribute>
        </xpath>

    </template>

</odoo>
