<odoo>
    <!-- stock.picking.batch form view -->
    <record model="ir.ui.view" id="stock_batch_picking_form">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <button name="action_print" position="before">
                <button name="l10n_ar_action_create_delivery_guide"
                        type="object"
                        string="Generate Delivery Guide"
                        invisible="country_code != 'AR' or not l10n_ar_allow_generate_delivery_guide or not partner_id"
                />
            </button>
            <field name="number_of_packages" position="after">
                <field name="l10n_ar_delivery_guide_number" invisible="country_code != 'AR' or not partner_id"/>
                <field name="declared_value" invisible="country_code != 'AR' or not partner_id"/>
            </field>
        </field>
    </record>

    <!-- a batch with contact gets a single delivery guide from our button -->
    <record id="stock_picking_batch_form_l10n_ar_stock" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.inherit.l10n_ar_stock_picking_batch</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="l10n_ar_stock.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_cancel']/following-sibling::button[@name='l10n_ar_action_create_delivery_guide'][1]" position="attributes">
                <attribute name="invisible">not l10n_ar_show_generate_delivery_guide or partner_id</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_batch_picking_tree_voucher">
        <field name="name">stock.picking.batch.tree</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock.stock_picking_batch_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_ar_delivery_guide_number" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
