<odoo>
    <!-- Server Action for Generate Delivery Guide from List View -->
    <record id="action_batch_generate_delivery_guide" model="ir.actions.server">
        <field name="name">Generate Delivery Guide</field>
        <field name="model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.l10n_ar_action_create_delivery_guide()
        </field>
    </record>

    <!-- stock.picking.batch form view -->
    <record model="ir.ui.view" id="stock_batch_picking_form">
        <field name="name">stock.picking.batch.form</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <button name="action_print" position="before">
                <button name="l10n_ar_action_create_delivery_guide"
                        type="object"
                        string="Generate Delivery Guide"
                        invisible="country_code != 'AR' or not l10n_ar_allow_generate_delivery_guide or not partner_id"
                />
            </button>
            <field name="number_of_packages" position="after">
                <field name="l10n_ar_delivery_guide_number" invisible="country_code != 'AR' or not partner_id"/>
                <field name="declared_value" invisible="country_code != 'AR' or not partner_id"/>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_batch_picking_tree_voucher">
        <field name="name">stock.picking.batch.tree</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock_picking_batch.stock_picking_batch_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_ar_delivery_guide_number" optional="hide"/>
            </field>
        </field>
    </record>

