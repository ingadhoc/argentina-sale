<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Argentine batch delivery document.
        Primary template that inherits from the generic batch report defined in
        stock_batch_picking_ux and adds the Argentine look (custom header/footer,
        AFIP barcode, CAI data, customer identification, COT, etc.).

        Mirrors what l10n_ar_stock_ux does for stock.report_delivery_document:
          l10n_ar_stock_ux.report_delivery_document
              inherit_id="stock.report_delivery_document" primary="True"

        Here:
          l10n_ar_stock_picking_batch.report_batch_delivery_document
              inherit_id="stock_batch_picking_ux.report_batch_delivery_document" primary="True"

        The line tables (stock_move_table / stock_move_line_table) and all the
        stock sub-template calls come from the grandparent
        (stock.report_delivery_document) through the batch base template —
        no duplication needed.
    -->
    <!--
        Inherit the batch entry-point to dynamically choose the Argentine report
        or the generic one, mirroring what l10n_ar_stock_ux does for stock.picking:

          <t t-call="stock.report_delivery_document" position="attributes">
              <attribute name="t-call">
                  #{ o._get_name_delivery_report('stock.report_delivery_document') }
              </attribute>
          </t>
    -->


</odoo>
